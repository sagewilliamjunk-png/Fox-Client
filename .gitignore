# Gradle build output
build/
.gradle/
out/

# Minecraft dev run directory (game saves, logs, options, etc.)
run/

# Launcher
launcher/node_modules/
launcher/dist/
launcher/out/

# OS
.DS_Store
Thumbs.db

# IntelliJ / VS Code
.idea/
*.iml
.vscode/

# Claude Code working files
.claude/

# Logs
*.log

# Local launcher data (auth tokens, settings, cache)
.foxlauncher/

# Large art files that don't need version control
"Fox art.png"
"Fox-1.png.png"
"transparant fox_2.png"
TheRealFoxArt.png

# Installer build artifacts
*.exe

# External jars dropped into the repo for ad-hoc inspection (anti-cheat,
# competitor analysis, etc.) — never commit these. The exception keeps
# build/libs/ untouched so our own build outputs aren't blocked when
# someone wants to track a specific release.
/*.jar
grimac-*.jar
meteor-*.jar
*-fabric-*.jar
!build/libs/*.jar

# Resource packs / images dropped into the root for testing — not part of
# the project (same spirit as the root-jar rule above).
/*.zip
/potato.png

# Decompiled / copied class & source files from auditing the cached MC jar.
# These are Mojang-owned and must never be tracked.
net/minecraft/**
com/mojang/**
com/google/**
*.class

# Local libs dropped in for ad-hoc builds (not part of the tracked source).
kitsune-libs/

# Malformed paths occasionally created on Windows when a literal absolute
# path gets concatenated into a command (e.g. "C:devAllowedMod...").
C:dev*

# Stray Java files that ended up in the repo root from earlier
# refactors — anything top-level is wrong (everything lives under src/).
/ZoomFeature.java
/ShulkerTooltipFeature.java
/MapTooltipFeature.java
