# Normalize line endings: store everything as LF in the repo, check out
# native on each OS. Stops the "LF will be replaced by CRLF" churn on Windows.
* text=auto eol=lf

# Scripts that MUST keep their platform endings
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew     text eol=lf
gradlew.bat text eol=crlf

# Binary assets — never normalize or diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.jar  binary
*.exe  binary
*.dll  binary
*.zip  binary
*.mrpack binary

# Collapse generated/vendored files in PR diffs and language stats
launcher/package-lock.json -diff linguist-generated
gradlew                    linguist-vendored
gradlew.bat                linguist-vendored
gradle/wrapper/**          linguist-vendored
