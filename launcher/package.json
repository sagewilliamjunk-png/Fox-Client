{
  "name": "fox-launcher",
  "version": "1.3.8",
  "description": "Fox Launcher — desktop launcher for the Kitsune Minecraft client",
  "main": "src/main/index.js",
  "author": "Kitsune / Fox Client",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "node scripts/release.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^30.4.2",
    "png-to-ico": "^3.0.1",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "dev.kitsune.foxlauncher",
    "productName": "Fox Launcher",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.js",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "sagewilliamjunk-png",
      "repo": "Fox-Client"
    },
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/fox.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/assets/fox.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/renderer/assets/fox-256.png",
      "category": "Game"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "yauzl": "^3.3.1"
  }
}
